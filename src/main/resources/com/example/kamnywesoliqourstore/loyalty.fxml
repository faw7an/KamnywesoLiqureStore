<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #F4F6FA; -fx-background: #F4F6FA; -fx-border-color: transparent;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.kamnywesoliqourstore.LoyaltyController">
    <content>
        <VBox style="-fx-background-color: #F4F6FA; -fx-padding: 24;" spacing="20.0">
            <children>

                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Loyalty Programme"
                                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                    <font><Font name="System Bold" size="22.0"/></font>
                                </Label>
                                <Label text="Manage customer loyalty cards, points and tiers"
                                       style="-fx-font-size: 13; -fx-text-fill: #666666;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- STAT CARDS -->
                <GridPane hgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                    </columnConstraints>
                    <rowConstraints><RowConstraints minHeight="80.0"/></rowConstraints>
                    <children>
                        <VBox GridPane.columnIndex="0" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 16 14 0;">
                            <children><HBox><children>
                                <StackPane prefWidth="4.0" prefHeight="50.0" style="-fx-background-color: #7C3AED; -fx-background-radius: 4 0 0 4;"/>
                                <VBox spacing="3.0" style="-fx-padding: 0 0 0 12;"><children>
                                    <Label text="Total Members" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                    <Label text="198" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;"><font><Font name="System Bold" size="20.0"/></font></Label>
                                    <Label text="Registered customers" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                </children></VBox>
                            </children></HBox></children>
                        </VBox>
                        <VBox GridPane.columnIndex="1" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 16 14 0;">
                            <children><HBox><children>
                                <StackPane prefWidth="4.0" prefHeight="50.0" style="-fx-background-color: #D97706; -fx-background-radius: 4 0 0 4;"/>
                                <VBox spacing="3.0" style="-fx-padding: 0 0 0 12;"><children>
                                    <Label text="Points Issued Today" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                    <Label text="1,840" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;"><font><Font name="System Bold" size="20.0"/></font></Label>
                                    <Label text="&#8593; 12% vs yesterday" style="-fx-font-size: 10; -fx-text-fill: #059669;"/>
                                </children></VBox>
                            </children></HBox></children>
                        </VBox>
                        <VBox GridPane.columnIndex="2" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 16 14 0;">
                            <children><HBox><children>
                                <StackPane prefWidth="4.0" prefHeight="50.0" style="-fx-background-color: #059669; -fx-background-radius: 4 0 0 4;"/>
                                <VBox spacing="3.0" style="-fx-padding: 0 0 0 12;"><children>
                                    <Label text="Gold Members" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                    <Label text="24" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;"><font><Font name="System Bold" size="20.0"/></font></Label>
                                    <Label text="Top spenders" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                </children></VBox>
                            </children></HBox></children>
                        </VBox>
                        <VBox GridPane.columnIndex="3" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 16 14 0;">
                            <children><HBox><children>
                                <StackPane prefWidth="4.0" prefHeight="50.0" style="-fx-background-color: #2563EB; -fx-background-radius: 4 0 0 4;"/>
                                <VBox spacing="3.0" style="-fx-padding: 0 0 0 12;"><children>
                                    <Label text="Total Points Balance" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                    <Label text="284,600" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;"><font><Font name="System Bold" size="20.0"/></font></Label>
                                    <Label text="Across all members" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                </children></VBox>
                            </children></HBox></children>
                        </VBox>
                    </children>
                </GridPane>

                <!-- MAIN: SEARCH + CARD + REGISTER -->
                <HBox spacing="16.0" alignment="TOP_LEFT">
                    <children>

                        <!-- LEFT: Search + Loyalty Card -->
                        <VBox HBox.hgrow="ALWAYS" spacing="14.0">
                            <children>

                                <!-- Search Card -->
                                <VBox style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 18;" spacing="10.0">
                                    <children>
                                        <Label text="Search Customer"
                                               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                            <font><Font name="System Bold" size="14.0"/></font>
                                        </Label>
                                        <HBox spacing="10.0">
                                            <children>
                                                <TextField fx:id="loyaltySearchField" HBox.hgrow="ALWAYS" prefHeight="38.0"
                                                           promptText="Search by name, phone or card ID..."
                                                           style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 8 0 8; -fx-font-size: 12;"/>
                                                <Button onAction="#handleSearchLoyalty" prefHeight="38.0" prefWidth="90.0"
                                                        text="Search"
                                                        style="-fx-background-color: #0D1B2A; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand; -fx-border-color: transparent;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Loyalty Card -->
                                <VBox style="-fx-background-color: #0D1B2A; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 24;"
                                      spacing="12.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="DrinkShop Loyalty"
                                                       style="-fx-font-size: 13; -fx-text-fill: #9CA3AF;"/>
                                                <javafx.scene.layout.Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="tierLabel" text="GOLD"
                                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #FCD34D; -fx-background-color: rgba(251,191,36,0.2); -fx-background-radius: 10; -fx-padding: 3 10 3 10;">
                                                    <font><Font name="System Bold" size="12.0"/></font>
                                                </Label>
                                            </children>
                                        </HBox>
                                        <Label fx:id="cardCustomerName" text="Harrison Mbugua"
                                               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;">
                                            <font><Font name="System Bold" size="22.0"/></font>
                                        </Label>
                                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                                            <children>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label text="Card ID" style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;"/>
                                                        <Label fx:id="cardId" text="LC-78432" style="-fx-font-size: 13; -fx-text-fill: #E5E7EB;"/>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label text="Phone" style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;"/>
                                                        <Label fx:id="cardPhone" text="+254 712 345 678" style="-fx-font-size: 13; -fx-text-fill: #E5E7EB;"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <VBox HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Points Balance" style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;"/>
                                                        <Label fx:id="pointsBalance" text="12,450"
                                                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #60A5FA;">
                                                            <font><Font name="System Bold" size="28.0"/></font>
                                                        </Label>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        <VBox spacing="4.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label fx:id="tierProgressLabel" text="12,450 / 15,000 pts to Diamond · 2,550 pts to go"
                                                               style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>
                                                <ProgressBar fx:id="tierProgressBar" progress="0.83" prefWidth="999.0" prefHeight="6.0"
                                                             style="-fx-accent: #FCD34D; -fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 4; -fx-border-radius: 4;"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <!-- Points Rules -->
                                <VBox style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 18;" spacing="10.0">
                                    <children>
                                        <Label text="How Points Are Earned"
                                               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                            <font><Font name="System Bold" size="14.0"/></font>
                                        </Label>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="&#11088;" style="-fx-font-size: 14;"/>
                                                <Label text="Per KES 10 spent  →  +1 point" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="&#11088;" style="-fx-font-size: 14;"/>
                                                <Label text="Wines and Whiskeys  →  +8 pts per item" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="&#11088;" style="-fx-font-size: 14;"/>
                                                <Label text="Soft drinks (Coke, Fanta, Sprite)  →  +2 pts per item" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="&#11088;" style="-fx-font-size: 14;"/>
                                                <Label text="Water and non-alcoholic  →  +1 pt per item" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>

                        <!-- RIGHT: Purchase History + Register -->
                        <VBox prefWidth="340.0" spacing="14.0">
                            <children>

                                <!-- Purchase History -->
                                <VBox maxWidth="380.0" minWidth="380.0" prefWidth="380.0"
                                        style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 18;" spacing="10.0">
                                    <children>
                                        <Label text="Purchase History"
                                               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                            <font><Font name="System Bold" size="14.0"/></font>
                                        </Label>
                                        <Separator style="-fx-background-color: #F3F4F6;"/>
                                        <HBox style="-fx-padding: 4 0 4 0; -fx-background-color: #F9FAFB;">
                                            <children>
                                                <Label text="Date" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                                <Label text="Items" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                                <Label text="Amount" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                                <Label text="Points" prefWidth="60.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                            </children>
                                        </HBox>
                                        <Separator style="-fx-background-color: #F3F4F6;"/>
                                        <VBox spacing="0.0">
                                            <children>
                                                <HBox style="-fx-padding: 8 0 8 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="25 Mar" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #444444;"/>
                                                        <Label text="Alvaro x2, Water x1" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #444444;"/>
                                                        <Label text="KES 290" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #0D1B2A;"/>
                                                        <Label text="+29 pts" prefWidth="60.0" style="-fx-font-size: 11; -fx-text-fill: #7C3AED; -fx-font-weight: bold;"/>
                                                    </children>
                                                </HBox>
                                                <HBox style="-fx-padding: 8 0 8 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="22 Mar" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #444444;"/>
                                                        <Label text="Wine x1, Fanta x3" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #444444;"/>
                                                        <Label text="KES 1,190" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #0D1B2A;"/>
                                                        <Label text="+125 pts" prefWidth="60.0" style="-fx-font-size: 11; -fx-text-fill: #7C3AED; -fx-font-weight: bold;"/>
                                                    </children>
                                                </HBox>
                                                <HBox style="-fx-padding: 8 0 8 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="18 Mar" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #444444;"/>
                                                        <Label text="Coca Cola x5" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #444444;"/>
                                                        <Label text="KES 400" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #0D1B2A;"/>
                                                        <Label text="+50 pts" prefWidth="60.0" style="-fx-font-size: 11; -fx-text-fill: #7C3AED; -fx-font-weight: bold;"/>
                                                    </children>
                                                </HBox>
                                                <HBox style="-fx-padding: 8 0 8 0;" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="14 Mar" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #444444;"/>
                                                        <Label text="Alvaro x3, Sprite x2" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #444444;"/>
                                                        <Label text="KES 520" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #0D1B2A;"/>
                                                        <Label text="+56 pts" prefWidth="60.0" style="-fx-font-size: 11; -fx-text-fill: #7C3AED; -fx-font-weight: bold;"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <!-- Register New Customer -->
                                <VBox style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 18;" spacing="12.0">
                                    <children>
                                        <Label text="Register New Loyalty Member"
                                               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                            <font><Font name="System Bold" size="14.0"/></font>
                                        </Label>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label text="FULL NAME" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                                <TextField fx:id="newMemberName" prefHeight="38.0" prefWidth="999.0"
                                                           promptText="John Doe"
                                                           style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 8 0 8;"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label text="PHONE NUMBER" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                                <TextField fx:id="newMemberPhone" prefHeight="38.0" prefWidth="999.0"
                                                           promptText="+254 7XX XXX XXX"
                                                           style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 8 0 8;"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label text="STARTING TIER" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                                <ComboBox fx:id="startingTier" prefHeight="38.0" prefWidth="999.0"
                                                          style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                                            </children>
                                        </VBox>
                                        <Button onAction="#handleRegisterMember" prefWidth="999.0" prefHeight="42.0"
                                                text="Register and Issue Card"
                                                style="-fx-background-color: #E04A2A; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-size: 13; -fx-cursor: hand; -fx-border-color: transparent;">
                                            <font><Font name="System Bold" size="13.0"/></font>
                                        </Button>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
