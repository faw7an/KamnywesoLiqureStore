<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #F4F6FA; -fx-background: #F4F6FA; -fx-border-color: transparent;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.kamnywesoliqourstore.OrderHistoryController">
    <content>
        <VBox style="-fx-background-color: #F4F6FA; -fx-padding: 24;" spacing="20.0">
            <children>

                <!-- HEADER -->
                <VBox spacing="3.0">
                    <children>
                        <Label text="Order History"
                               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                            <font><Font name="System Bold" size="22.0"/></font>
                        </Label>
                        <Label fx:id="subTitleLabel"
                               text="All orders placed at this branch"
                               style="-fx-font-size: 13; -fx-text-fill: #666666;"/>
                    </children>
                </VBox>

                <!-- FILTER BAR -->
                <HBox spacing="10.0" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 18 14 18;">
                    <children>
                        <DatePicker fx:id="fromDatePicker"
                                    prefHeight="36.0" prefWidth="150.0"
                                    promptText="From date"
                                    style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <DatePicker fx:id="toDatePicker"
                                    prefHeight="36.0" prefWidth="150.0"
                                    promptText="To date"
                                    style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <ComboBox fx:id="statusFilter"
                                  prefHeight="36.0" prefWidth="150.0"
                                  promptText="All Statuses"
                                  style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <TextField fx:id="searchField"
                                   prefHeight="36.0" prefWidth="200.0"
                                   promptText="Search by customer or order ID..."
                                   style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 8 0 8; -fx-font-size: 12;"/>
                        <Button onAction="#handleApplyFilter"
                                prefHeight="36.0" prefWidth="80.0" text="Apply"
                                style="-fx-background-color: #0D1B2A; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand; -fx-border-color: transparent;"/>
                    </children>
                </HBox>

                <!-- ORDERS TABLE -->
                <VBox style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 18;"
                      spacing="10.0">
                    <children>

                        <Label text="Orders"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                            <font><Font name="System Bold" size="15.0"/></font>
                        </Label>
                        <Separator style="-fx-background-color: #F3F4F6;"/>

                        <!-- Header -->
                        <HBox style="-fx-padding: 6 0 6 0; -fx-background-color: #F9FAFB;">
                            <children>
                                <Label text="Order ID"   prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-padding: 0 0 0 8;"/>
                                <Label text="Customer"   prefWidth="150.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Items"      prefWidth="180.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Total (KES)" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Status"     prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Time"       prefWidth="120.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Actions"    prefWidth="90.0"  style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>
                        <Separator style="-fx-background-color: #F3F4F6;"/>

                        <!-- Table rows -->
                        <VBox fx:id="ordersBody" spacing="0.0">
                            <children>
                                <!-- Row 1 -->
                                <HBox style="-fx-padding: 10 0 10 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="#ORD-8829" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-padding: 0 0 0 8;"/>
                                        <Label text="Alice Mwangi"  prefWidth="150.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A;"/>
                                        <Label text="Alvaro x2, Water x1" prefWidth="180.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <Label text="KES 290" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A; -fx-font-weight: bold;"/>
                                        <Label text="Completed" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #065F46; -fx-background-color: #D1FAE5; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <Label text="Today 09:14" prefWidth="120.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                        <Button onAction="#handleViewReceipt" prefHeight="28.0" prefWidth="80.0" text="View Receipt"
                                                style="-fx-background-color: transparent; -fx-border-color: #E04A2A; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #E04A2A; -fx-font-size: 11; -fx-cursor: hand;"/>
                                    </children>
                                </HBox>
                                <!-- Row 2 -->
                                <HBox style="-fx-padding: 10 0 10 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="#ORD-8828" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-padding: 0 0 0 8;"/>
                                        <Label text="Brian Otieno"  prefWidth="150.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A;"/>
                                        <Label text="Coca Cola x3, Fanta x2" prefWidth="180.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <Label text="KES 400" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A; -fx-font-weight: bold;"/>
                                        <Label text="Completed" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #065F46; -fx-background-color: #D1FAE5; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <Label text="Today 08:45" prefWidth="120.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                        <Button onAction="#handleViewReceipt" prefHeight="28.0" prefWidth="80.0" text="View Receipt"
                                                style="-fx-background-color: transparent; -fx-border-color: #E04A2A; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #E04A2A; -fx-font-size: 11; -fx-cursor: hand;"/>
                                    </children>
                                </HBox>
                                <!-- Row 3 -->
                                <HBox style="-fx-padding: 10 0 10 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="#ORD-8827" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-padding: 0 0 0 8;"/>
                                        <Label text="Carol Njeri"  prefWidth="150.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A;"/>
                                        <Label text="Sprite x4" prefWidth="180.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <Label text="KES 320" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A; -fx-font-weight: bold;"/>
                                        <Label text="Pending" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #92400E; -fx-background-color: #FEF3C7; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <Label text="Today 08:10" prefWidth="120.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                        <Button onAction="#handleViewReceipt" prefHeight="28.0" prefWidth="80.0" text="View Receipt"
                                                style="-fx-background-color: transparent; -fx-border-color: #E04A2A; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #E04A2A; -fx-font-size: 11; -fx-cursor: hand;"/>
                                    </children>
                                </HBox>
                                <!-- Row 4 -->
                                <HBox style="-fx-padding: 10 0 10 0;" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="#ORD-8820" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-padding: 0 0 0 8;"/>
                                        <Label text="David Kamau"  prefWidth="150.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A;"/>
                                        <Label text="Alvaro x1" prefWidth="180.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <Label text="KES 120" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A; -fx-font-weight: bold;"/>
                                        <Label text="Cancelled" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #991B1B; -fx-background-color: #FEE2E2; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <Label text="24 Mar 17:30" prefWidth="120.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                        <Button onAction="#handleViewReceipt" prefHeight="28.0" prefWidth="80.0" text="View Receipt"
                                                style="-fx-background-color: transparent; -fx-border-color: #E04A2A; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #E04A2A; -fx-font-size: 11; -fx-cursor: hand;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
