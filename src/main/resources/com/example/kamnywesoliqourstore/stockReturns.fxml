<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #F4F6FA; -fx-background: #F4F6FA; -fx-border-color: transparent;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.kamnywesoliqourstore.StockReturnsController">
    <content>
        <VBox style="-fx-background-color: #F4F6FA; -fx-padding: 24;" spacing="20.0">
            <children>

                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Stock Returns"
                                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                    <font><Font name="System Bold" size="22.0"/></font>
                                </Label>
                                <Label text="Return damaged or expired stock to HQ for review"
                                       style="-fx-font-size: 13; -fx-text-fill: #666666;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="16.0" alignment="TOP_LEFT">
                    <children>

                        <!-- LEFT: Raise New Return Form -->
                        <VBox prefWidth="340.0"
                              style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 18;"
                              spacing="14.0">
                            <children>
                                <Label text="Raise New Return Request"
                                       style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                    <font><Font name="System Bold" size="15.0"/></font>
                                </Label>
                                <Separator style="-fx-background-color: #F3F4F6;"/>

                                <VBox spacing="4.0">
                                    <children>
                                        <Label text="ITEM" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                        <ComboBox fx:id="returnItemCombo" prefHeight="38.0" prefWidth="999.0"
                                                  promptText="Select item to return"
                                                  style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                                    </children>
                                </VBox>

                                <VBox spacing="4.0">
                                    <children>
                                        <Label text="BRANCH" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                        <TextField fx:id="returnBranchField" prefHeight="38.0" prefWidth="999.0"
                                                   editable="false"
                                                   style="-fx-background-color: #F9FAFB; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 8 0 8; -fx-text-fill: #666666;"/>
                                    </children>
                                </VBox>

                                <VBox spacing="4.0">
                                    <children>
                                        <Label text="QUANTITY" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                        <TextField fx:id="returnQtyField" prefHeight="38.0" prefWidth="999.0"
                                                   promptText="Enter quantity"
                                                   style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 8 0 8;"/>
                                    </children>
                                </VBox>

                                <VBox spacing="4.0">
                                    <children>
                                        <Label text="REASON FOR RETURN" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                        <TextArea fx:id="returnReasonField" prefHeight="90.0" prefWidth="999.0"
                                                  promptText="Describe the damage or reason for return..."
                                                  wrapText="true"
                                                  style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
                                    </children>
                                </VBox>

                                <!-- Error label -->
                                <Label fx:id="returnErrorLabel" prefWidth="999.0"
                                       style="-fx-text-fill: red; -fx-font-size: 12;"
                                       text="" visible="false"/>

                                <Button onAction="#handleSubmitReturn" prefWidth="999.0" prefHeight="44.0"
                                        text="Submit Return Request"
                                        style="-fx-background-color: #E04A2A; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 13; -fx-cursor: hand; -fx-border-color: transparent;">
                                    <font><Font name="System Bold" size="13.0"/></font>
                                </Button>
                            </children>
                        </VBox>

                        <!-- RIGHT: Return Requests Table -->
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 18;"
                              spacing="12.0">
                            <children>
                                <Label text="My Return Requests"
                                       style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                    <font><Font name="System Bold" size="15.0"/></font>
                                </Label>
                                <Separator style="-fx-background-color: #F3F4F6;"/>

                                <!-- Table header -->
                                <HBox style="-fx-padding: 6 0 6 0; -fx-background-color: #F9FAFB;">
                                    <children>
                                        <Label text="Return ID" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-padding: 0 0 0 8;"/>
                                        <Label text="Item" prefWidth="130.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                        <Label text="Qty" prefWidth="50.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                        <Label text="Reason" prefWidth="150.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                        <Label text="Date Raised" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                        <Label text="Status" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                        <Label text="HQ Response" prefWidth="160.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                    </children>
                                </HBox>
                                <Separator style="-fx-background-color: #F3F4F6;"/>

                                <!-- Table rows -->
                                <VBox spacing="0.0">
                                    <children>
                                        <HBox style="-fx-padding: 10 0 10 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="RET-001" prefWidth="90.0" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-padding: 0 0 0 8;"/>
                                                <Label text="Alvaro 500ml" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A;"/>
                                                <Label text="5" prefWidth="50.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="Broken bottles" prefWidth="150.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                                <Label text="25 Mar 2026" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                                <Label text="Pending Review" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #92400E; -fx-background-color: #FEF3C7; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                                <Label text="Awaiting HQ review" prefWidth="160.0" style="-fx-font-size: 11; -fx-text-fill: #888888;"/>
                                            </children>
                                        </HBox>
                                        <HBox style="-fx-padding: 10 0 10 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="RET-002" prefWidth="90.0" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-padding: 0 0 0 8;"/>
                                                <Label text="Fanta Orange" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A;"/>
                                                <Label text="3" prefWidth="50.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="Expired stock" prefWidth="150.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                                <Label text="20 Mar 2026" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                                <Label text="Approved" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #065F46; -fx-background-color: #D1FAE5; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                                <Label text="Replacement: ORD-8840" prefWidth="160.0" style="-fx-font-size: 11; -fx-text-fill: #2563EB;"/>
                                            </children>
                                        </HBox>
                                        <HBox style="-fx-padding: 10 0 10 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="RET-003" prefWidth="90.0" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-padding: 0 0 0 8;"/>
                                                <Label text="Coca Cola 500ml" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A;"/>
                                                <Label text="10" prefWidth="50.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="Wrong delivery" prefWidth="150.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                                <Label text="15 Mar 2026" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                                <Label text="Rejected" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #991B1B; -fx-background-color: #FEE2E2; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                                <Label text="Insufficient evidence" prefWidth="160.0" style="-fx-font-size: 11; -fx-text-fill: #888888;"/>
                                            </children>
                                        </HBox>
                                        <HBox style="-fx-padding: 10 0 10 0;" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="RET-004" prefWidth="90.0" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-padding: 0 0 0 8;"/>
                                                <Label text="Sprite 500ml" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A;"/>
                                                <Label text="8" prefWidth="50.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="Damaged packaging" prefWidth="150.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                                <Label text="10 Mar 2026" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                                <Label text="Replacement Sent" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #1D4ED8; -fx-background-color: #DBEAFE; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                                <Label text="ORD-8838 received" prefWidth="160.0" style="-fx-font-size: 11; -fx-text-fill: #059669;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
