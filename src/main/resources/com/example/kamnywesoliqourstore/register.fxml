<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: #D6D6D1;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.kamnywesoliqourstore.RegisterController">

    <BorderPane maxHeight="-Infinity" maxWidth="-Infinity"
                minHeight="-Infinity" minWidth="-Infinity"
                prefHeight="660.0" prefWidth="620.0">

        <!-- LEFT - same decorative image panel as login -->
        <center>
            <AnchorPane prefHeight="660.0" prefWidth="228.0" BorderPane.alignment="CENTER">
                <children>
                    <ImageView fitHeight="660.0" fitWidth="233.0"
                               pickOnBounds="true" preserveRatio="false"
                               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                        <image>
                            <Image url="@distributedsystemprojectimages/one.jpg" />
                        </image>
                    </ImageView>
                </children>
            </AnchorPane>
        </center>

        <!-- RIGHT - registration form panel -->
        <right>
            <AnchorPane prefHeight="660.0" prefWidth="392.0"
                        style="-fx-background-color: #ECECE7;"
                        BorderPane.alignment="CENTER">
                <children>

                    <!-- ═══════════════════════════════════════
                         HEADER (shared across all steps)
                         ═══════════════════════════════════════ -->
                    <Label layoutX="14.0" layoutY="18.0" prefWidth="364.0"
                           alignment="CENTER"
                           text="Create Account"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;">
                        <font><Font name="System Bold" size="22.0" /></font>
                    </Label>
                    <Label layoutX="14.0" layoutY="48.0" prefWidth="364.0"
                           alignment="CENTER"
                           text="Join DrinkShop Management System"
                           style="-fx-text-fill: #888888;">
                        <font><Font size="13.0" /></font>
                    </Label>

                    <!-- Step indicator dots -->
                    <HBox layoutX="14.0" layoutY="74.0" prefWidth="364.0"
                          alignment="CENTER" spacing="10.0">
                        <children>
                            <Label fx:id="dot1" text="&#9679;"
                                   style="-fx-text-fill: #E04A2A; -fx-font-size: 18;">
                            </Label>
                            <Label fx:id="dot2" text="&#9679;"
                                   style="-fx-text-fill: #CCCCCC; -fx-font-size: 18;">
                            </Label>
                            <Label fx:id="dot3" text="&#9679;"
                                   style="-fx-text-fill: #CCCCCC; -fx-font-size: 18;">
                            </Label>
                        </children>
                    </HBox>

                    <!-- ═══════════════════════════════════════
                         STEP 1 - Personal Info
                         ═══════════════════════════════════════ -->
                    <VBox fx:id="step1Pane" layoutX="14.0" layoutY="108.0"
                          prefWidth="364.0" spacing="6.0" visible="true">
                        <children>

                            <!-- Full Name -->
                            <Label text="FULL NAME">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>
                            <TextField fx:id="fullNameField"
                                       prefHeight="38.0" prefWidth="364.0"
                                       promptText="John Doe"
                                       style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 6 0 6;" />

                            <!-- Phone Number -->
                            <Label text="PHONE NUMBER" style="-fx-padding: 6 0 0 0;">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>
                            <TextField fx:id="phoneField"
                                       prefHeight="38.0" prefWidth="364.0"
                                       promptText="+254 7XX XXX XXX"
                                       style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 6 0 6;" />

                            <!-- Email -->
                            <Label text="EMAIL" style="-fx-padding: 6 0 0 0;">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>
                            <TextField fx:id="emailField"
                                       prefHeight="38.0" prefWidth="364.0"
                                       promptText="john@example.com"
                                       style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 6 0 6;" />

                            <!-- Branch -->
                            <Label text="BRANCH" style="-fx-padding: 6 0 0 0;">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>
                            <ComboBox fx:id="regBranchComboBox"
                                      prefHeight="38.0" prefWidth="364.0"
                                      promptText="Select your branch"
                                      style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4;" />

                            <!-- Role -->
                            <Label text="ROLE" style="-fx-padding: 6 0 0 0;">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>
                            <ComboBox fx:id="roleComboBox"
                                      prefHeight="38.0" prefWidth="364.0"
                                      promptText="Select your role"
                                      style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4;" />

                            <!-- Step 1 error label -->
                            <Label fx:id="step1ErrorLabel"
                                   prefWidth="364.0" alignment="CENTER"
                                   style="-fx-text-fill: red; -fx-font-size: 12;"
                                   text="" visible="false">
                            </Label>

                            <!-- Continue button -->
                            <Button onAction="#handleStep1Continue"
                                    prefHeight="44.0" prefWidth="364.0"
                                    style="-fx-background-color: #E04A2A; -fx-background-radius: 6; -fx-cursor: hand;"
                                    text="Continue  -&gt;"
                                    textFill="WHITE">
                                <font><Font name="System Bold" size="16.0" /></font>
                            </Button>

                        </children>
                    </VBox>

                    <!-- ═══════════════════════════════════════
                         STEP 2 - Password
                         ═══════════════════════════════════════ -->
                    <VBox fx:id="step2Pane" layoutX="14.0" layoutY="108.0"
                          prefWidth="364.0" spacing="6.0" visible="false">
                        <children>

                            <!-- Password -->
                            <Label text="PASSWORD">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>
                            <PasswordField fx:id="regPasswordField"
                                           prefHeight="38.0" prefWidth="364.0"
                                           promptText="Enter password"
                                           style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 6 0 6;" />

                            <!-- Confirm Password -->
                            <Label text="CONFIRM PASSWORD" style="-fx-padding: 6 0 0 0;">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>
                            <PasswordField fx:id="confirmPasswordField"
                                           prefHeight="38.0" prefWidth="364.0"
                                           promptText="Confirm password"
                                           style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 6 0 6;" />

                            <!-- Password rules -->
                            <VBox spacing="4.0" style="-fx-padding: 10 0 0 0;">
                                <children>
                                    <Label fx:id="rule8Chars"
                                           text="X  At least 8 characters"
                                           style="-fx-text-fill: #999999; -fx-font-size: 12;">
                                    </Label>
                                    <Label fx:id="ruleUppercase"
                                           text="X  One uppercase letter"
                                           style="-fx-text-fill: #999999; -fx-font-size: 12;">
                                    </Label>
                                    <Label fx:id="ruleNumber"
                                           text="X  One number"
                                           style="-fx-text-fill: #999999; -fx-font-size: 12;">
                                    </Label>
                                    <Label fx:id="ruleSpecial"
                                           text="X  One special symbol"
                                           style="-fx-text-fill: #999999; -fx-font-size: 12;">
                                    </Label>
                                </children>
                            </VBox>

                            <!-- Step 2 error label -->
                            <Label fx:id="step2ErrorLabel"
                                   prefWidth="364.0" alignment="CENTER"
                                   style="-fx-text-fill: red; -fx-font-size: 12;"
                                   text="" visible="false">
                            </Label>

                            <!-- Back + Continue buttons -->
                            <HBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                                <children>
                                    <Button onAction="#handleStep2Back"
                                            prefHeight="44.0" prefWidth="170.0"
                                            style="-fx-background-color: transparent; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"
                                            text="&lt;-  Back">
                                        <font><Font name="System Bold" size="14.0" /></font>
                                    </Button>
                                    <Button onAction="#handleStep2Continue"
                                            prefHeight="44.0" prefWidth="184.0"
                                            style="-fx-background-color: #E04A2A; -fx-background-radius: 6; -fx-cursor: hand;"
                                            text="Continue  -&gt;" textFill="WHITE">
                                        <font><Font name="System Bold" size="14.0" /></font>
                                    </Button>
                                </children>
                            </HBox>

                        </children>
                    </VBox>

                    <!-- ═══════════════════════════════════════
                         STEP 3 - OTP Verification
                         ═══════════════════════════════════════ -->
                    <VBox fx:id="step3Pane" layoutX="14.0" layoutY="108.0"
                          prefWidth="364.0" spacing="10.0" visible="false">
                        <children>

                            <!-- OTP sent message -->
                            <Label fx:id="otpSentLabel"
                                   prefWidth="364.0" alignment="CENTER"
                                   text="OTP sent to +254 7XX XXX XXX"
                                   style="-fx-text-fill: #444444; -fx-font-size: 13;">
                            </Label>

                            <!-- 6 OTP input boxes -->
                            <HBox alignment="CENTER" spacing="8.0"
                                  style="-fx-padding: 10 0 10 0;">
                                <children>
                                    <TextField fx:id="otp1" prefHeight="56.0" prefWidth="52.0"
                                               style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 20; -fx-alignment: center;" />
                                    <TextField fx:id="otp2" prefHeight="56.0" prefWidth="52.0"
                                               style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 20; -fx-alignment: center;" />
                                    <TextField fx:id="otp3" prefHeight="56.0" prefWidth="52.0"
                                               style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 20; -fx-alignment: center;" />
                                    <TextField fx:id="otp4" prefHeight="56.0" prefWidth="52.0"
                                               style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 20; -fx-alignment: center;" />
                                    <TextField fx:id="otp5" prefHeight="56.0" prefWidth="52.0"
                                               style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 20; -fx-alignment: center;" />
                                    <TextField fx:id="otp6" prefHeight="56.0" prefWidth="52.0"
                                               style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 20; -fx-alignment: center;" />
                                </children>
                            </HBox>

                            <!-- Countdown timer -->
                            <Label fx:id="timerLabel"
                                   prefWidth="364.0" alignment="CENTER"
                                   text="Resend code in 04:59"
                                   style="-fx-text-fill: #555555; -fx-font-size: 13;">
                            </Label>

                            <!-- Resend button (hidden until timer expires) -->
                            <Button fx:id="resendBtn"
                                    onAction="#handleResendOtp"
                                    prefWidth="364.0" prefHeight="34.0"
                                    text="Resend OTP"
                                    visible="false"
                                    style="-fx-background-color: transparent; -fx-border-color: #E04A2A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-text-fill: #E04A2A;">
                                <font><Font size="13.0" /></font>
                            </Button>

                            <!-- Step 3 error label -->
                            <Label fx:id="step3ErrorLabel"
                                   prefWidth="364.0" alignment="CENTER"
                                   style="-fx-text-fill: red; -fx-font-size: 12;"
                                   text="" visible="false">
                            </Label>

                            <!-- Awaiting approval notice -->
                            <Label prefWidth="364.0" alignment="CENTER"
                                   text="AWAITING MANAGER APPROVAL BEFORE ACCOUNT IS ACTIVATED"
                                   style="-fx-text-fill: #E08A00; -fx-font-size: 10; -fx-font-weight: bold;">
                                <font><Font name="System Bold" size="10.0" /></font>
                            </Label>

                            <!-- Back + Complete Registration buttons -->
                            <HBox spacing="10.0" style="-fx-padding: 6 0 0 0;">
                                <children>
                                    <Button onAction="#handleStep3Back"
                                            prefHeight="44.0" prefWidth="110.0"
                                            style="-fx-background-color: transparent; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"
                                            text="&lt;-  Back">
                                        <font><Font name="System Bold" size="13.0" /></font>
                                    </Button>
                                    <Button onAction="#handleCompleteRegistration"
                                            prefHeight="44.0" prefWidth="244.0"
                                            style="-fx-background-color: #E04A2A; -fx-background-radius: 6; -fx-cursor: hand;"
                                            text="Complete Registration" textFill="WHITE">
                                        <font><Font name="System Bold" size="13.0" /></font>
                                    </Button>
                                </children>
                            </HBox>

                        </children>
                    </VBox>

                    <!-- ═══════════════════════════════════════
                         BOTTOM - shared across all steps
                         ═══════════════════════════════════════ -->
                    <Separator layoutX="14.0" layoutY="610.0" prefWidth="364.0"
                               style="-fx-background-color: #CCCCCC;" />

                    <HBox alignment="CENTER" layoutX="14.0" layoutY="622.0"
                          prefHeight="35.0" prefWidth="364.0" spacing="5.0">
                        <children>
                            <Label text="Already have an account?">
                                <font><Font size="13.0" /></font>
                            </Label>
                            <Hyperlink onAction="#handleSignIn"
                                       style="-fx-text-fill: #1a73e8;" text="Sign In">
                                <font><Font size="13.0" /></font>
                            </Hyperlink>
                        </children>
                    </HBox>

                </children>
            </AnchorPane>
        </right>

    </BorderPane>
</StackPane>

