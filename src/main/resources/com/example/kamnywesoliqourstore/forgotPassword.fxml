<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="750.0" prefWidth="900.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kamnywesoliqourstore.ForgotPasswordController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="0">
            <!-- Header Section -->
            <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 30;">
                <VBox alignment="CENTER" spacing="8.0">
                    <Label style="-fx-font-size: 32px;" text="🔐" />
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" styleClass="text-navy" text="Forgot Password?" />
                    <Label styleClass="text-muted" text="Reset your account password securely" />
                </VBox>
            </VBox>

            <!-- Main Content Card -->
            <VBox alignment="TOP_CENTER" prefHeight="600" maxWidth="480.0" spacing="20.0" styleClass="card" style="-fx-padding: 30;" VBox.vgrow="ALWAYS">
                <children>
                    <!-- Progress Dots -->
                    <HBox alignment="CENTER" spacing="15.0">
                        <Label fx:id="dot1" styleClass="dot, dot-active" text="●" />
                        <Label fx:id="dot2" styleClass="dot" text="●" />
                        <Label fx:id="dot3" styleClass="dot" text="●" />
                    </HBox>

                    <!-- ═════════════════════════════════════════════════════════════ -->
                    <!-- STEP 1: VERIFY ACCOUNT -->
                    <!-- ═════════════════════════════════════════════════════════════ -->
                    <VBox fx:id="step1Pane" spacing="12.0">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" styleClass="text-navy" text="Verify Your Account" />

                        <!-- Error Label -->
                        <Label fx:id="step1ErrorLabel" styleClass="text-danger" text="Error message" visible="false" wrapText="true" />

                        <!-- Staff ID / Email -->
                        <VBox spacing="5.0">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 11px;" styleClass="text-muted" text="STAFF ID / EMAIL" />
                            <TextField fx:id="identifierField" promptText="e.g. DS-4421 or john@example.com" styleClass="input-field" />
                        </VBox>

                        <!-- OTP Method Selection -->
                        <VBox spacing="10.0" style="-fx-padding: 10 0;">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 11px;" styleClass="text-muted" text="SEND RESET CODE VIA" />

                            <HBox spacing="20.0">
                                <RadioButton fx:id="phoneRadio" selected="true" style="-fx-font-size: 12px;" text="Phone Number">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="otpMethodGroup" />
                                    </toggleGroup>
                                </RadioButton>
                                <RadioButton fx:id="emailRadio" style="-fx-font-size: 12px;" text="Email Address" toggleGroup="$otpMethodGroup" />
                            </HBox>
                        </VBox>

                        <!-- Info Label -->
                        <Label fx:id="sendToInfoLabel" styleClass="text-muted" text="Reset code will be sent to the phone number linked to your account." wrapText="true" />

                        <!-- Continue Button -->
                        <Button maxWidth="Infinity" onAction="#handleStep1Continue" styleClass="button-primary" text="Send Reset Code →" />
                    </VBox>

                    <!-- ═════════════════════════════════════════════════════════════ -->
                    <!-- STEP 2: VERIFY CODE -->
                    <!-- ═════════════════════════════════════════════════════════════ -->
                    <VBox fx:id="step2Pane" spacing="12.0" visible="false" managed="false">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" styleClass="text-navy" text="Verify Reset Code" />

                        <!-- Error Label -->
                        <Label fx:id="step2ErrorLabel" styleClass="text-danger" text="Error message" visible="false" wrapText="true" />

                        <!-- OTP Sent Info -->
                        <Label fx:id="otpSentLabel" styleClass="text-muted" text="Reset code sent to +254 7XX XXX 678" />

                        <!-- OTP Input Boxes -->
                        <HBox alignment="CENTER" spacing="8.0" style="-fx-padding: 10;">
                            <TextField fx:id="otp1" maxWidth="45.0" promptText="0" styleClass="otp-input" />
                            <TextField fx:id="otp2" maxWidth="45.0" promptText="0" styleClass="otp-input" />
                            <TextField fx:id="otp3" maxWidth="45.0" promptText="0" styleClass="otp-input" />
                            <TextField fx:id="otp4" maxWidth="45.0" promptText="0" styleClass="otp-input" />
                            <TextField fx:id="otp5" maxWidth="45.0" promptText="0" styleClass="otp-input" />
                            <TextField fx:id="otp6" maxWidth="45.0" promptText="0" styleClass="otp-input" />
                        </HBox>

                        <!-- Timer and Resend -->
                        <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 12; -fx-background-color: #f9fafb; -fx-background-radius: 8;">
                            <Label fx:id="timerLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" styleClass="text-primary" text="Resend code in 04:59" />
                            <Button fx:id="resendBtn" onAction="#handleResendOtp" styleClass="button-ghost" text="Resend Code" visible="false" />
                        </VBox>

                        <!-- Navigation Buttons -->
                        <HBox spacing="10.0">
                            <Button maxWidth="Infinity" onAction="#handleStep2Back" styleClass="button-ghost" text="← Back" HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity" onAction="#handleStep2Continue" styleClass="button-primary" text="Verify Code →" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>

                    <!-- ═════════════════════════════════════════════════════════════ -->
                    <!-- STEP 3: RESET PASSWORD -->
                    <!-- ═════════════════════════════════════════════════════════════ -->
                    <VBox fx:id="step3Pane" spacing="12.0" visible="false" managed="false">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" styleClass="text-navy" text="Create New Password" />

                        <!-- Error Label -->
                        <Label fx:id="step3ErrorLabel" styleClass="text-danger" text="Error message" visible="false" wrapText="true" />

                        <!-- Success Label -->
                        <Label fx:id="successLabel" style="-fx-text-fill: #22C55E; -fx-font-weight: bold;" text="Password reset successfully! Redirecting to login..." visible="false" wrapText="true" />

                        <!-- New Password -->
                        <VBox spacing="5.0">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 11px;" styleClass="text-muted" text="NEW PASSWORD" />
                            <PasswordField fx:id="newPasswordField" promptText="••••••••" styleClass="input-field" />
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox spacing="5.0">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 11px;" styleClass="text-muted" text="CONFIRM PASSWORD" />
                            <PasswordField fx:id="confirmNewPasswordField" promptText="••••••••" styleClass="input-field" />
                        </VBox>

                        <!-- Password Rules -->
                        <VBox spacing="6.0" style="-fx-padding: 12; -fx-background-color: #f9fafb; -fx-background-radius: 8;">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" styleClass="text-muted" text="PASSWORD MUST HAVE:" />
                            <Label fx:id="rule8Chars" styleClass="rule-text" text="X  At least 8 characters" />
                            <Label fx:id="ruleUppercase" styleClass="rule-text" text="X  One uppercase letter (A-Z)" />
                            <Label fx:id="ruleNumber" styleClass="rule-text" text="X  One number (0-9)" />
                            <Label fx:id="ruleSpecial" styleClass="rule-text" text="X  One special character (!@#$%)" />
                        </VBox>

                        <!-- Navigation Buttons -->
                        <HBox spacing="10.0">
                            <Button maxWidth="Infinity" onAction="#handleStep3Back" styleClass="button-ghost" text="← Back" HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity" onAction="#handleResetPassword" styleClass="button-primary" text="Reset Password" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>

                    <!-- Sign In Link -->
                    <HBox alignment="CENTER" spacing="5.0" style="-fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-padding: 15 0 0 0;">
                        <Label styleClass="text-muted" text="Remembered your password?" />
                        <Label onMouseClicked="#handleBackToLogin" style="-fx-font-weight: bold; -fx-cursor: hand;" styleClass="text-primary" text="Sign In" />
                    </HBox>
                </children>
            </VBox>
        </VBox>
    </children>
</StackPane>
