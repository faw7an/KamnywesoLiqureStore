<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: #D6D6D1;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.kamnywesoliqourstore.ForgotPasswordController">

    <BorderPane maxHeight="-Infinity" maxWidth="-Infinity"
                minHeight="-Infinity" minWidth="-Infinity"
                prefHeight="620.0" prefWidth="620.0">

        <!-- LEFT - same decorative image panel -->
        <center>
            <AnchorPane prefHeight="620.0" prefWidth="228.0" BorderPane.alignment="CENTER">
                <children>
                    <ImageView fitHeight="620.0" fitWidth="233.0"
                               pickOnBounds="true" preserveRatio="false"
                               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                        <image>
                            <Image url="@distributedsystemprojectimages/one.jpg" />
                        </image>
                    </ImageView>
                </children>
            </AnchorPane>
        </center>

        <!-- RIGHT - forgot password form -->
        <right>
            <AnchorPane prefHeight="620.0" prefWidth="392.0"
                        style="-fx-background-color: #ECECE7;"
                        BorderPane.alignment="CENTER">
                <children>

                    <!-- ═══════════════════════════════════════
                         HEADER (shared across all steps)
                         ═══════════════════════════════════════ -->
                    <Label layoutX="14.0" layoutY="18.0" prefWidth="364.0"
                           alignment="CENTER"
                           text="Forgot Password"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;">
                        <font><Font name="System Bold" size="22.0" /></font>
                    </Label>
                    <Label layoutX="14.0" layoutY="50.0" prefWidth="364.0"
                           alignment="CENTER"
                           text="Reset your DrinkShop account password"
                           style="-fx-text-fill: #888888;">
                        <font><Font size="13.0" /></font>
                    </Label>

                    <!-- Step indicator dots -->
                    <HBox layoutX="14.0" layoutY="76.0" prefWidth="364.0"
                          alignment="CENTER" spacing="10.0">
                        <children>
                            <Label fx:id="dot1" text="&#9679;"
                                   style="-fx-text-fill: #E04A2A; -fx-font-size: 18;" />
                            <Label fx:id="dot2" text="&#9679;"
                                   style="-fx-text-fill: #CCCCCC; -fx-font-size: 18;" />
                            <Label fx:id="dot3" text="&#9679;"
                                   style="-fx-text-fill: #CCCCCC; -fx-font-size: 18;" />
                        </children>
                    </HBox>

                    <!-- ═══════════════════════════════════════
                         STEP 1 - Enter Details
                         ═══════════════════════════════════════ -->
                    <VBox fx:id="step1Pane" layoutX="14.0" layoutY="110.0"
                          prefWidth="364.0" spacing="8.0" visible="true">
                        <children>

                            <Label text="STAFF ID / EMAIL">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>
                            <TextField fx:id="identifierField"
                                       prefHeight="38.0" prefWidth="364.0"
                                       promptText="Enter your Staff ID or Email"
                                       style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 6 0 6;" />

                            <!-- Verification method -->
                            <Label text="SEND OTP VIA" style="-fx-padding: 10 0 0 0;">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>

                            <HBox spacing="20.0" style="-fx-padding: 4 0 4 0;">
                                <children>
                                    <RadioButton fx:id="phoneRadio"
                                                 text="Phone Number"
                                                 selected="true"
                                                 style="-fx-font-size: 13;">
                                        <toggleGroup>
                                            <ToggleGroup fx:id="otpMethodGroup" />
                                        </toggleGroup>
                                    </RadioButton>
                                    <RadioButton fx:id="emailRadio"
                                                 text="Email Address"
                                                 toggleGroup="$otpMethodGroup"
                                                 style="-fx-font-size: 13;" />
                                </children>
                            </HBox>

                            <!-- Info label showing where OTP will be sent -->
                            <Label fx:id="sendToInfoLabel"
                                   prefWidth="364.0"
                                   text="OTP will be sent to the phone number linked to your account."
                                   style="-fx-text-fill: #888888; -fx-font-size: 11; -fx-wrap-text: true;" />

                            <!-- Step 1 error -->
                            <Label fx:id="step1ErrorLabel"
                                   prefWidth="364.0" alignment="CENTER"
                                   style="-fx-text-fill: red; -fx-font-size: 12;"
                                   text="" visible="false" />

                            <!-- Continue button -->
                            <Button onAction="#handleStep1Continue"
                                    prefHeight="44.0" prefWidth="364.0"
                                    style="-fx-background-color: #E04A2A; -fx-background-radius: 6; -fx-cursor: hand;"
                                    text="Continue  -&gt;" textFill="WHITE">

                                <font><Font name="System Bold" size="16.0" /></font>
                            </Button>

                        </children>
                    </VBox>

                    <!-- ═══════════════════════════════════════
                         STEP 2 - Verify OTP
                         ═══════════════════════════════════════ -->
                    <VBox fx:id="step2Pane" layoutX="14.0" layoutY="110.0"
                          prefWidth="364.0" spacing="10.0" visible="false">
                        <children>

                            <!-- OTP sent message -->
                            <Label fx:id="otpSentLabel"
                                   prefWidth="364.0" alignment="CENTER"
                                   text="OTP sent to your phone"
                                   style="-fx-text-fill: #444444; -fx-font-size: 13; -fx-wrap-text: true;" />

                            <!-- 6 OTP boxes -->
                            <HBox alignment="CENTER" spacing="8.0"
                                  style="-fx-padding: 10 0 10 0;">
                                <children>
                                    <TextField fx:id="otp1" prefHeight="56.0" prefWidth="52.0"
                                               style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 20; -fx-alignment: center;" />
                                    <TextField fx:id="otp2" prefHeight="56.0" prefWidth="52.0"
                                               style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 20; -fx-alignment: center;" />
                                    <TextField fx:id="otp3" prefHeight="56.0" prefWidth="52.0"
                                               style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 20; -fx-alignment: center;" />
                                    <TextField fx:id="otp4" prefHeight="56.0" prefWidth="52.0"
                                               style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 20; -fx-alignment: center;" />
                                    <TextField fx:id="otp5" prefHeight="56.0" prefWidth="52.0"
                                               style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 20; -fx-alignment: center;" />
                                    <TextField fx:id="otp6" prefHeight="56.0" prefWidth="52.0"
                                               style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 20; -fx-alignment: center;" />
                                </children>
                            </HBox>

                            <!-- Countdown timer -->
                            <Label fx:id="timerLabel"
                                   prefWidth="364.0" alignment="CENTER"
                                   text="Resend code in 04:59"
                                   style="-fx-text-fill: #555555; -fx-font-size: 13;" />

                            <!-- Resend button -->
                            <Button fx:id="resendBtn"
                                    onAction="#handleResendOtp"
                                    prefWidth="364.0" prefHeight="34.0"
                                    text="Resend OTP" visible="false"
                                    style="-fx-background-color: transparent; -fx-border-color: #E04A2A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-text-fill: #E04A2A;">
                                <font><Font size="13.0" /></font>
                            </Button>

                            <!-- Step 2 error -->
                            <Label fx:id="step2ErrorLabel"
                                   prefWidth="364.0" alignment="CENTER"
                                   style="-fx-text-fill: red; -fx-font-size: 12;"
                                   text="" visible="false" />

                            <!-- Back + Continue -->
                            <HBox spacing="10.0" style="-fx-padding: 6 0 0 0;">
                                <children>
                                    <Button onAction="#handleStep2Back"
                                            prefHeight="44.0" prefWidth="170.0"
                                            style="-fx-background-color: transparent; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"
                                            text="&lt;-  Back">
                                        <font><Font name="System Bold" size="14.0" /></font>
                                    </Button>
                                    <Button onAction="#handleStep2Continue"
                                            prefHeight="44.0" prefWidth="184.0"
                                            style="-fx-background-color: #E04A2A; -fx-background-radius: 6; -fx-cursor: hand;"
                                            text="Continue  -&gt;" textFill="WHITE">
                                        <font><Font name="System Bold" size="14.0" /></font>
                                    </Button>
                                </children>
                            </HBox>

                        </children>
                    </VBox>

                    <!-- ═══════════════════════════════════════
                         STEP 3 - Reset Password
                         ═══════════════════════════════════════ -->
                    <VBox fx:id="step3Pane" layoutX="14.0" layoutY="110.0"
                          prefWidth="364.0" spacing="8.0" visible="false">
                        <children>

                            <Label text="NEW PASSWORD">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>
                            <PasswordField fx:id="newPasswordField"
                                           prefHeight="38.0" prefWidth="364.0"
                                           promptText="Enter new password"
                                           style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 6 0 6;" />

                            <Label text="CONFIRM NEW PASSWORD" style="-fx-padding: 6 0 0 0;">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>
                            <PasswordField fx:id="confirmNewPasswordField"
                                           prefHeight="38.0" prefWidth="364.0"
                                           promptText="Confirm new password"
                                           style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 6 0 6;" />

                            <!-- Password rules -->
                            <VBox spacing="4.0" style="-fx-padding: 8 0 0 0;">
                                <children>
                                    <Label fx:id="rule8Chars"
                                           text="X  At least 8 characters"
                                           style="-fx-text-fill: #999999; -fx-font-size: 12;" />
                                    <Label fx:id="ruleUppercase"
                                           text="X  One uppercase letter"
                                           style="-fx-text-fill: #999999; -fx-font-size: 12;" />
                                    <Label fx:id="ruleNumber"
                                           text="X  One number"
                                           style="-fx-text-fill: #999999; -fx-font-size: 12;" />
                                    <Label fx:id="ruleSpecial"
                                           text="X  One special symbol"
                                           style="-fx-text-fill: #999999; -fx-font-size: 12;" />
                                </children>
                            </VBox>

                            <!-- Step 3 error -->
                            <Label fx:id="step3ErrorLabel"
                                   prefWidth="364.0" alignment="CENTER"
                                   style="-fx-text-fill: red; -fx-font-size: 12;"
                                   text="" visible="false" />

                            <!-- Success label -->
                            <Label fx:id="successLabel"
                                   prefWidth="364.0" alignment="CENTER"
                                   style="-fx-text-fill: #4CAF50; -fx-font-size: 12;"
                                   text="Password reset successfully! Redirecting to login..."
                                   visible="false" />

                            <!-- Back + Reset Password -->
                            <HBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                                <children>
                                    <Button onAction="#handleStep3Back"
                                            prefHeight="44.0" prefWidth="140.0"
                                            style="-fx-background-color: transparent; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"
                                            text="&lt;-  Back">
                                        <font><Font name="System Bold" size="13.0" /></font>
                                    </Button>
                                    <Button onAction="#handleResetPassword"
                                            prefHeight="44.0" prefWidth="214.0"
                                            style="-fx-background-color: #E04A2A; -fx-background-radius: 6; -fx-cursor: hand;"
                                            text="Reset Password" textFill="WHITE">
                                        <font><Font name="System Bold" size="13.0" /></font>
                                    </Button>
                                </children>
                            </HBox>

                        </children>
                    </VBox>

                    <!-- ═══════════════════════════════════════
                         BOTTOM - shared across all steps
                         ═══════════════════════════════════════ -->
                    <Separator layoutX="14.0" layoutY="568.0" prefWidth="364.0"
                               style="-fx-background-color: #CCCCCC;" />

                    <HBox alignment="CENTER" layoutX="14.0" layoutY="580.0"
                          prefHeight="35.0" prefWidth="364.0" spacing="5.0">
                        <children>
                            <Label text="Remembered your password?">
                                <font><Font size="13.0" /></font>
                            </Label>
                            <Hyperlink onAction="#handleBackToLogin"
                                       style="-fx-text-fill: #1a73e8;" text="Sign In">
                                <font><Font size="13.0" /></font>
                            </Hyperlink>
                        </children>
                    </HBox>

                </children>
            </AnchorPane>
        </right>

    </BorderPane>
</StackPane>
