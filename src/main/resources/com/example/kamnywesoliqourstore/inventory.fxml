<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #F4F6FA; -fx-background: #F4F6FA; -fx-border-color: transparent;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.kamnywesoliqourstore.InventoryController">
    <content>
        <VBox style="-fx-background-color: #F4F6FA; -fx-padding: 24;" spacing="20.0">
            <children>

                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Inventory Management"
                                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                    <font><Font name="System Bold" size="22.0"/></font>
                                </Label>
                                <Label text="Monitor and manage stock levels across all branches"
                                       style="-fx-font-size: 13; -fx-text-fill: #666666;"/>
                            </children>
                        </VBox>
                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#handleAddStock" text="+ Add Stock Item"
                                style="-fx-background-color: #E04A2A; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand; -fx-padding: 8 16 8 16; -fx-border-color: transparent;">
                            <font><Font name="System Bold" size="12.0"/></font>
                        </Button>
                    </children>
                </HBox>

                <!-- STAT CARDS -->
                <GridPane hgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                    </columnConstraints>
                    <rowConstraints><RowConstraints minHeight="80.0"/></rowConstraints>
                    <children>
                        <VBox GridPane.columnIndex="0"
                              style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 16 14 0;">
                            <children>
                                <HBox>
                                    <children>
                                        <StackPane prefWidth="4.0" prefHeight="50.0" style="-fx-background-color: #2563EB; -fx-background-radius: 4 0 0 4;"/>
                                        <VBox spacing="3.0" style="-fx-padding: 0 0 0 12;">
                                            <children>
                                                <Label text="Total SKUs" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                                <Label fx:id="totalSkusLabel" text="48" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;"><font><Font name="System Bold" size="20.0"/></font></Label>
                                                <Label text="Across all branches" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox GridPane.columnIndex="1"
                              style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 16 14 0;">
                            <children>
                                <HBox>
                                    <children>
                                        <StackPane prefWidth="4.0" prefHeight="50.0" style="-fx-background-color: #D97706; -fx-background-radius: 4 0 0 4;"/>
                                        <VBox spacing="3.0" style="-fx-padding: 0 0 0 12;">
                                            <children>
                                                <Label text="Low Stock" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                                <Label fx:id="lowStockLabel" text="5" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #D97706;"><font><Font name="System Bold" size="20.0"/></font></Label>
                                                <Label text="Below threshold" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox GridPane.columnIndex="2"
                              style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 16 14 0;">
                            <children>
                                <HBox>
                                    <children>
                                        <StackPane prefWidth="4.0" prefHeight="50.0" style="-fx-background-color: #DC2626; -fx-background-radius: 4 0 0 4;"/>
                                        <VBox spacing="3.0" style="-fx-padding: 0 0 0 12;">
                                            <children>
                                                <Label text="Out of Stock" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                                <Label fx:id="outOfStockLabel" text="2" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #DC2626;"><font><Font name="System Bold" size="20.0"/></font></Label>
                                                <Label text="Need restocking" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox GridPane.columnIndex="3"
                              style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 16 14 0;">
                            <children>
                                <HBox>
                                    <children>
                                        <StackPane prefWidth="4.0" prefHeight="50.0" style="-fx-background-color: #7C3AED; -fx-background-radius: 4 0 0 4;"/>
                                        <VBox spacing="3.0" style="-fx-padding: 0 0 0 12;">
                                            <children>
                                                <Label text="Pending Returns" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                                <Label fx:id="pendingReturnsLabel" text="3" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #7C3AED;"><font><Font name="System Bold" size="20.0"/></font></Label>
                                                <Label text="Awaiting review" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <!-- FILTER + TABLE -->
                <VBox style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 18;" spacing="12.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Stock Inventory"
                                       style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                    <font><Font name="System Bold" size="15.0"/></font>
                                </Label>
                                <javafx.scene.layout.Region HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="searchField" prefHeight="34.0" prefWidth="180.0"
                                           promptText="Search item..."
                                           style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 8 0 8; -fx-font-size: 12;"/>
                                <ComboBox fx:id="branchFilter" prefHeight="34.0" prefWidth="150.0"
                                          promptText="All Branches"
                                          style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                                <ComboBox fx:id="statusFilter" prefHeight="34.0" prefWidth="130.0"
                                          promptText="All Status"
                                          style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                            </children>
                        </HBox>
                        <Separator style="-fx-background-color: #F3F4F6;"/>

                        <!-- Table Header -->
                        <HBox style="-fx-padding: 6 0 6 0; -fx-background-color: #F9FAFB;">
                            <children>
                                <Label text="Item Name" prefWidth="140.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-padding: 0 0 0 8;"/>
                                <Label text="Branch" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Current Stock" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Min Threshold" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Stock Level" prefWidth="130.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Status" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Last Restocked" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Action" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>
                        <Separator style="-fx-background-color: #F3F4F6;"/>

                        <!-- Table Rows -->
                        <VBox fx:id="inventoryTableBody" spacing="0.0">
                            <children>
                                <!-- Row 1: OK -->
                                <HBox style="-fx-padding: 10 0 10 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                    <children>
                                        <VBox prefWidth="140.0" style="-fx-padding: 0 0 0 8;">
                                            <children>
                                                <Label text="Alvaro 500ml" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;"/>
                                                <Label text="Non-alcoholic" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                            </children>
                                        </VBox>
                                        <Label text="Nairobi HQ" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                        <Label text="45 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A; -fx-font-weight: bold;"/>
                                        <Label text="20 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <VBox prefWidth="130.0">
                                            <children>
                                                <ProgressBar progress="0.75" prefWidth="110.0" prefHeight="6.0"
                                                             style="-fx-accent: #059669; -fx-background-color: #E5E7EB; -fx-background-radius: 4; -fx-border-radius: 4;"/>
                                            </children>
                                        </VBox>
                                        <Label text="OK" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #065F46; -fx-background-color: #D1FAE5; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <Label text="20 Mar 2026" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                        <Button onAction="#handleRestock" prefWidth="80.0" prefHeight="28.0" text="Restock"
                                                style="-fx-background-color: transparent; -fx-border-color: #2563EB; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #2563EB; -fx-font-size: 11; -fx-cursor: hand;"/>
                                    </children>
                                </HBox>
                                <!-- Row 2: Low -->
                                <HBox style="-fx-padding: 10 0 10 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                    <children>
                                        <VBox prefWidth="140.0" style="-fx-padding: 0 0 0 8;">
                                            <children>
                                                <Label text="Fanta Orange 500ml" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;"/>
                                                <Label text="Soft drink" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                            </children>
                                        </VBox>
                                        <Label text="Mombasa" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                        <Label text="8 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #D97706; -fx-font-weight: bold;"/>
                                        <Label text="15 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <VBox prefWidth="130.0">
                                            <children>
                                                <ProgressBar progress="0.27" prefWidth="110.0" prefHeight="6.0"
                                                             style="-fx-accent: #D97706; -fx-background-color: #E5E7EB; -fx-background-radius: 4; -fx-border-radius: 4;"/>
                                            </children>
                                        </VBox>
                                        <Label text="Low" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #92400E; -fx-background-color: #FEF3C7; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <Label text="15 Mar 2026" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                        <Button onAction="#handleRestock" prefWidth="80.0" prefHeight="28.0" text="Restock"
                                                style="-fx-background-color: #E04A2A; -fx-background-radius: 4; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-border-color: transparent;"/>
                                    </children>
                                </HBox>
                                <!-- Row 3: Critical -->
                                <HBox style="-fx-padding: 10 0 10 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                    <children>
                                        <VBox prefWidth="140.0" style="-fx-padding: 0 0 0 8;">
                                            <children>
                                                <Label text="Coca Cola 500ml" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;"/>
                                                <Label text="Soft drink" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                            </children>
                                        </VBox>
                                        <Label text="Kisumu" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                        <Label text="3 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #DC2626; -fx-font-weight: bold;"/>
                                        <Label text="20 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <VBox prefWidth="130.0">
                                            <children>
                                                <ProgressBar progress="0.08" prefWidth="110.0" prefHeight="6.0"
                                                             style="-fx-accent: #DC2626; -fx-background-color: #E5E7EB; -fx-background-radius: 4; -fx-border-radius: 4;"/>
                                            </children>
                                        </VBox>
                                        <Label text="Critical" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #991B1B; -fx-background-color: #FEE2E2; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <Label text="10 Mar 2026" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                        <Button onAction="#handleRestock" prefWidth="80.0" prefHeight="28.0" text="Restock"
                                                style="-fx-background-color: #DC2626; -fx-background-radius: 4; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-border-color: transparent;"/>
                                    </children>
                                </HBox>
                                <!-- Row 4: Out of Stock -->
                                <HBox style="-fx-padding: 10 0 10 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                    <children>
                                        <VBox prefWidth="140.0" style="-fx-padding: 0 0 0 8;">
                                            <children>
                                                <Label text="Sprite 500ml" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;"/>
                                                <Label text="Soft drink" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                            </children>
                                        </VBox>
                                        <Label text="Nakuru" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                        <Label text="0 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #DC2626; -fx-font-weight: bold;"/>
                                        <Label text="20 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <VBox prefWidth="130.0">
                                            <children>
                                                <ProgressBar progress="0.0" prefWidth="110.0" prefHeight="6.0"
                                                             style="-fx-accent: #DC2626; -fx-background-color: #E5E7EB; -fx-background-radius: 4; -fx-border-radius: 4;"/>
                                            </children>
                                        </VBox>
                                        <Label text="Out of Stock" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #991B1B; -fx-background-color: #FEE2E2; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <Label text="01 Mar 2026" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                        <Button onAction="#handleRestock" prefWidth="80.0" prefHeight="28.0" text="Restock"
                                                style="-fx-background-color: #DC2626; -fx-background-radius: 4; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-border-color: transparent;"/>
                                    </children>
                                </HBox>
                                <!-- Row 5: OK -->
                                <HBox style="-fx-padding: 10 0 10 0;" alignment="CENTER_LEFT">
                                    <children>
                                        <VBox prefWidth="140.0" style="-fx-padding: 0 0 0 8;">
                                            <children>
                                                <Label text="Dasani Water 500ml" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;"/>
                                                <Label text="Water" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                            </children>
                                        </VBox>
                                        <Label text="Nairobi HQ" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                        <Label text="200 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #059669; -fx-font-weight: bold;"/>
                                        <Label text="30 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <VBox prefWidth="130.0">
                                            <children>
                                                <ProgressBar progress="0.95" prefWidth="110.0" prefHeight="6.0"
                                                             style="-fx-accent: #059669; -fx-background-color: #E5E7EB; -fx-background-radius: 4; -fx-border-radius: 4;"/>
                                            </children>
                                        </VBox>
                                        <Label text="OK" prefWidth="90.0" style="-fx-font-size: 11; -fx-text-fill: #065F46; -fx-background-color: #D1FAE5; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <Label text="22 Mar 2026" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                        <Button onAction="#handleRestock" prefWidth="80.0" prefHeight="28.0" text="Restock"
                                                style="-fx-background-color: transparent; -fx-border-color: #2563EB; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #2563EB; -fx-font-size: 11; -fx-cursor: hand;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- DAMAGED STOCK RETURNS SECTION -->
                <VBox style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 18;" spacing="12.0">
                    <children>
                        <Label text="Damaged Stock Returns"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                            <font><Font name="System Bold" size="15.0"/></font>
                        </Label>
                        <Separator style="-fx-background-color: #F3F4F6;"/>
                        <HBox style="-fx-padding: 6 0 6 0; -fx-background-color: #F9FAFB;">
                            <children>
                                <Label text="Return ID" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-padding: 0 0 0 8;"/>
                                <Label text="Branch" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Item" prefWidth="130.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Qty" prefWidth="60.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Reason" prefWidth="160.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Status" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                <Label text="Actions" prefWidth="120.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>
                        <Separator style="-fx-background-color: #F3F4F6;"/>
                        <VBox spacing="0.0">
                            <children>
                                <HBox style="-fx-padding: 9 0 9 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="RET-001" prefWidth="100.0" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-padding: 0 0 0 8;"/>
                                        <Label text="Nakuru" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                        <Label text="Alvaro 500ml" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A;"/>
                                        <Label text="5" prefWidth="60.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A;"/>
                                        <Label text="Broken bottles" prefWidth="160.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <Label text="Pending Review" prefWidth="110.0" style="-fx-font-size: 11; -fx-text-fill: #92400E; -fx-background-color: #FEF3C7; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <HBox spacing="6.0">
                                            <children>
                                                <Button onAction="#handleApproveReturn" prefHeight="28.0" prefWidth="68.0" text="Approve"
                                                        style="-fx-background-color: #059669; -fx-background-radius: 4; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-border-color: transparent;"/>
                                                <Button onAction="#handleRejectReturn" prefHeight="28.0" prefWidth="52.0" text="Reject"
                                                        style="-fx-background-color: transparent; -fx-border-color: #DC2626; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #DC2626; -fx-font-size: 11; -fx-cursor: hand;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>
                                <HBox style="-fx-padding: 9 0 9 0;" alignment="CENTER_LEFT">
