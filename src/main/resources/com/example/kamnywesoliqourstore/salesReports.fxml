<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #F4F6FA; -fx-background: #F4F6FA; -fx-border-color: transparent;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.kamnywesoliqourstore.SalesReportsController">
    <content>
        <VBox style="-fx-background-color: #F4F6FA; -fx-padding: 24;" spacing="20.0">
            <children>

                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Sales Reports"
                                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                    <font><Font name="System Bold" size="22.0"/></font>
                                </Label>
                                <Label text="Generate and export detailed business reports"
                                       style="-fx-font-size: 13; -fx-text-fill: #666666;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- MAIN CONTENT: LEFT SIDEBAR + RIGHT PREVIEW -->
                <HBox spacing="16.0" alignment="TOP_LEFT">
                    <children>

                        <!-- LEFT: Report Type Selector + Config -->
                        <VBox prefWidth="280.0" spacing="14.0">
                            <children>

                                <!-- Report Type Selector -->
                                <VBox style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 18;" spacing="8.0">
                                    <children>
                                        <Label text="Report Type"
                                               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                            <font><Font name="System Bold" size="14.0"/></font>
                                        </Label>
                                        <Button fx:id="btnSales" onAction="#selectSales" prefWidth="244.0" prefHeight="38.0" text="Sales Report"
                                                style="-fx-background-color: #E04A2A; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-size: 13; -fx-cursor: hand; -fx-border-color: transparent; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 12;"/>
                                        <Button fx:id="btnPnL" onAction="#selectPnL" prefWidth="244.0" prefHeight="38.0" text="Profit and Loss"
                                                style="-fx-background-color: transparent; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #444444; -fx-font-size: 13; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 12;"/>
                                        <Button fx:id="btnOrders" onAction="#selectOrders" prefWidth="244.0" prefHeight="38.0" text="Order Report"
                                                style="-fx-background-color: transparent; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #444444; -fx-font-size: 13; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 12;"/>
                                        <Button fx:id="btnStock" onAction="#selectStock" prefWidth="244.0" prefHeight="38.0" text="Stock Movement"
                                                style="-fx-background-color: transparent; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #444444; -fx-font-size: 13; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 12;"/>
                                        <Button fx:id="btnCustomer" onAction="#selectCustomer" prefWidth="244.0" prefHeight="38.0" text="Customer History"
                                                style="-fx-background-color: transparent; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #444444; -fx-font-size: 13; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 12;"/>
                                    </children>
                                </VBox>

                                <!-- Report Config -->
                                <VBox style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 18;" spacing="12.0">
                                    <children>
                                        <Label text="Report Configuration"
                                               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                            <font><Font name="System Bold" size="14.0"/></font>
                                        </Label>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label text="FROM DATE" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                                <DatePicker fx:id="fromDate" prefWidth="244.0" prefHeight="36.0"
                                                            style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label text="TO DATE" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                                <DatePicker fx:id="toDate" prefWidth="244.0" prefHeight="36.0"
                                                            style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label text="BRANCH" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                                <ComboBox fx:id="branchSelector" prefWidth="244.0" prefHeight="36.0"
                                                          promptText="Select branch"
                                                          style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="6.0">
                                            <children>
                                                <Label text="FORMAT" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                                <HBox spacing="16.0">
                                                    <children>
                                                        <RadioButton fx:id="pdfRadio" text="PDF" selected="true" style="-fx-font-size: 13;">
                                                            <toggleGroup><ToggleGroup fx:id="formatGroup"/></toggleGroup>
                                                        </RadioButton>
                                                        <RadioButton fx:id="csvRadio" text="CSV / Excel" toggleGroup="$formatGroup" style="-fx-font-size: 13;"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <Button onAction="#handleGenerateReport" prefWidth="244.0" prefHeight="44.0"
                                                text="Generate Report"
                                                style="-fx-background-color: #E04A2A; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-size: 14; -fx-cursor: hand; -fx-border-color: transparent;">
                                            <font><Font name="System Bold" size="14.0"/></font>
                                        </Button>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>

                        <!-- RIGHT: Report Preview -->
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 18;"
                              spacing="14.0">
                            <children>

                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label fx:id="reportTitleLabel" text="Sales Report"
                                                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                                    <font><Font name="System Bold" size="16.0"/></font>
                                                </Label>
                                                <Label fx:id="reportSubtitleLabel" text="All Branches · 01 Mar 2026 – 25 Mar 2026"
                                                       style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                            </children>
                                        </VBox>
                                        <Button onAction="#handleExportPDF" prefHeight="36.0"
                                                text="Export PDF"
                                                style="-fx-background-color: #0D1B2A; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand; -fx-border-color: transparent; -fx-padding: 0 14 0 14;">
                                            <font><Font name="System Bold" size="12.0"/></font>
                                        </Button>
                                    </children>
                                </HBox>

                                <!-- Summary cards -->
                                <GridPane hgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                                    </columnConstraints>
                                    <children>
                                        <VBox GridPane.columnIndex="0" style="-fx-background-color: #F9FAFB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;" spacing="4.0">
                                            <children>
                                                <Label text="Total Revenue" style="-fx-font-size: 11; -fx-text-fill: #888888;"/>
                                                <Label text="KES 284,500" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #059669;"><font><Font name="System Bold" size="16.0"/></font></Label>
                                                <Label text="&#8593; 12% vs last period" style="-fx-font-size: 11; -fx-text-fill: #059669;"/>
                                            </children>
                                        </VBox>
                                        <VBox GridPane.columnIndex="1" style="-fx-background-color: #F9FAFB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;" spacing="4.0">
                                            <children>
                                                <Label text="Total Orders" style="-fx-font-size: 11; -fx-text-fill: #888888;"/>
                                                <Label text="1,847" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2563EB;"><font><Font name="System Bold" size="16.0"/></font></Label>
                                                <Label text="&#8593; 8% vs last period" style="-fx-font-size: 11; -fx-text-fill: #059669;"/>
                                            </children>
                                        </VBox>
                                        <VBox GridPane.columnIndex="2" style="-fx-background-color: #F9FAFB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;" spacing="4.0">
                                            <children>
                                                <Label text="Net Profit" style="-fx-font-size: 11; -fx-text-fill: #888888;"/>
                                                <Label text="KES 79,400" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #D97706;"><font><Font name="System Bold" size="16.0"/></font></Label>
                                                <Label text="&#8593; 5% vs last period" style="-fx-font-size: 11; -fx-text-fill: #059669;"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <Separator style="-fx-background-color: #F3F4F6;"/>

                                <!-- Report Table Preview -->
                                <HBox style="-fx-padding: 6 0 6 0; -fx-background-color: #F9FAFB;">
                                    <children>
                                        <Label text="Branch" prefWidth="130.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-padding: 0 0 0 8;"/>
                                        <Label text="Revenue" prefWidth="120.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                        <Label text="Orders" prefWidth="80.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                        <Label text="Avg Order Value" prefWidth="130.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                        <Label text="Top Item" prefWidth="130.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                        <Label text="Growth" prefWidth="80.0" style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
                                    </children>
                                </HBox>
                                <Separator style="-fx-background-color: #F3F4F6;"/>
                                <VBox spacing="0.0">
                                    <children>
                                        <HBox style="-fx-padding: 9 0 9 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Nairobi HQ" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A; -fx-font-weight: bold; -fx-padding: 0 0 0 8;"/>
                                                <Label text="KES 98,400" prefWidth="120.0" style="-fx-font-size: 12; -fx-text-fill: #059669;"/>
                                                <Label text="620" prefWidth="80.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="KES 158.71" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="Coca Cola" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="&#8593; 14%" prefWidth="80.0" style="-fx-font-size: 12; -fx-text-fill: #059669;"/>
                                            </children>
                                        </HBox>
                                        <HBox style="-fx-padding: 9 0 9 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Mombasa" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A; -fx-font-weight: bold; -fx-padding: 0 0 0 8;"/>
                                                <Label text="KES 72,100" prefWidth="120.0" style="-fx-font-size: 12; -fx-text-fill: #059669;"/>
                                                <Label text="484" prefWidth="80.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="KES 148.97" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="Alvaro" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="&#8593; 9%" prefWidth="80.0" style="-fx-font-size: 12; -fx-text-fill: #059669;"/>
                                            </children>
                                        </HBox>
                                        <HBox style="-fx-padding: 9 0 9 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Kisumu" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A; -fx-font-weight: bold; -fx-padding: 0 0 0 8;"/>
                                                <Label text="KES 63,800" prefWidth="120.0" style="-fx-font-size: 12; -fx-text-fill: #059669;"/>
                                                <Label text="410" prefWidth="80.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="KES 155.61" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="Fanta Orange" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="&#8593; 6%" prefWidth="80.0" style="-fx-font-size: 12; -fx-text-fill: #059669;"/>
                                            </children>
                                        </HBox>
                                        <HBox style="-fx-padding: 9 0 9 0;" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Nakuru" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #0D1B2A; -fx-font-weight: bold; -fx-padding: 0 0 0 8;"/>
                                                <Label text="KES 50,200" prefWidth="120.0" style="-fx-font-size: 12; -fx-text-fill: #DC2626;"/>
                                                <Label text="333" prefWidth="80.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="KES 150.75" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="Sprite" prefWidth="130.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                                <Label text="&#8595; 3%" prefWidth="80.0" style="-fx-font-size: 12; -fx-text-fill: #DC2626;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Total Row -->
                                <HBox style="-fx-background-color: #0D1B2A; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 8 12 8;" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="TOTAL (All Branches)" prefWidth="130.0" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 0 0;"><font><Font name="System Bold" size="13.0"/></font></Label>
                                        <Label text="KES 284,500" prefWidth="120.0" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #4ADE80;"><font><Font name="System Bold" size="13.0"/></font></Label>
                                        <Label text="1,847" prefWidth="80.0" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: white;"><font><Font name="System Bold" size="13.0"/></font></Label>
                                        <Label text="KES 154.03" prefWidth="130.0" style="-fx-font-size: 13; -fx-text-fill: #D1D5DB;"/>
                                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS"/>
                                        <Label text="&#8593; 9% overall" style="-fx-font-size: 12; -fx-text-fill: #4ADE80;"/>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
