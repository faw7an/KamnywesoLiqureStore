                                                style="-fx-background-color: transparent; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #444444; -fx-font-size: 12; -fx-cursor: hand;"/>
                                        <Button onAction="#handleSendStock" prefHeight="34.0" HBox.hgrow="ALWAYS"
                                                text="Send Stock"
                                                style="-fx-background-color: #DC2626; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand; -fx-border-color: transparent;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </GridPane>

            </children>
        </VBox>
    </content>
</ScrollPane>

