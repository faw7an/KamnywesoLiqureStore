<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<StackPane prefHeight="700.0" prefWidth="900.0" stylesheets="@style.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kamnywesoliqourstore.LoginController">
    <children>
        <VBox alignment="CENTER" prefHeight="600" maxWidth="420.0" maxHeight="-Infinity" spacing="25.0" styleClass="card">
            <children>
                <VBox alignment="CENTER" spacing="10.0">
                    <Label styleClass="logo-box" text="KLS" />
                    <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" styleClass="text-navy" text="Kamnyweso Liquor Store" />
                    <Label styleClass="text-muted" text="Distributed Management System" />
                </VBox>

                <!-- Error Message Label (initially hidden) -->
                <Label fx:id="errorLabel" styleClass="text-danger" text="Error message" visible="false" wrapText="true" />

                <VBox spacing="15.0">
                    <children>
                        <!-- Branch Selection -->
                        <VBox spacing="5.0">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 11px;" styleClass="text-muted" text="BRANCH" />
                            <ComboBox fx:id="branchComboBox" maxWidth="Infinity" promptText="Select Branch" styleClass="input-field" onAction="#handleBranchSelection" />
                        </VBox>

                        <!-- Staff ID / Email (FIXED: was unnamed) -->
                        <VBox spacing="5.0">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 11px;" styleClass="text-muted" text="STAFF ID / EMAIL" />
                            <TextField fx:id="staffIdField" promptText="e.g. DS-4421" styleClass="input-field" />
                        </VBox>

                        <!-- Password -->
                        <VBox spacing="5.0">
                            <HBox alignment="CENTER_LEFT">
                                <Label style="-fx-font-weight: bold; -fx-font-size: 11px;" styleClass="text-muted" text="PASSWORD" />
                                <Region HBox.hgrow="ALWAYS" />
                                <!-- FIXED: Added handler for Forgot Password -->
                                <Label fx:id="forgotPasswordLabel" onMouseClicked="#handleForgotPassword" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-cursor: hand;" styleClass="text-primary" text="Forgot?" />
                            </HBox>
                            <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="input-field" />
                        </VBox>

                        <!-- Remember Device Checkbox (FIXED: Added fx:id) -->
                        <CheckBox fx:id="rememberMeCheckBox" styleClass="text-muted" text="Remember this device" />
                    </children>
                </VBox>

                <!-- FIXED: Changed fx:id from loginButton to signInButton -->
                <Button fx:id="signInButton" maxWidth="Infinity" onAction="#handleLogin" styleClass="button-primary" text="Sign In →" />

                <!-- Sign Up Section -->
                <VBox alignment="CENTER" spacing="10.0" style="-fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-padding: 20 0 0 0;">
                    <HBox alignment="CENTER" spacing="5.0">
                        <Label styleClass="text-muted" text="Don't have an account?" />
                        <!-- FIXED: Added fx:id for sign-up label -->
                        <Label fx:id="signUpLabel" onMouseClicked="#handleSignUp" style="-fx-font-weight: bold; -fx-cursor: hand;" styleClass="text-primary" text="Register" />
                    </HBox>
                    <Label style="-fx-font-size: 9px; -fx-letter-spacing: 1px;" styleClass="text-muted" text="SESSIONS EXPIRE AFTER 30 MIN OF INACTIVITY" />
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
