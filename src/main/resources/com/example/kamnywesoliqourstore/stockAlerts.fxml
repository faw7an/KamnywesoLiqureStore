<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #F4F6FA; -fx-background: #F4F6FA; -fx-border-color: transparent;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.kamnywesoliqourstore.StockAlertsController">
    <content>
        <VBox style="-fx-background-color: #F4F6FA; -fx-padding: 24;" spacing="20.0">
            <children>

                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Stock Alerts"
                                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;">
                                    <font><Font name="System Bold" size="22.0"/></font>
                                </Label>
                                <Label fx:id="pageSubtitle"
                                       text="Items below minimum threshold"
                                       style="-fx-font-size: 13; -fx-text-fill: #666666;"/>
                            </children>
                        </VBox>
                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS"/>
                        <!-- HQ only: Acknowledge All -->
                        <Button fx:id="acknowledgeAllBtn" onAction="#handleAcknowledgeAll"
                                text="Acknowledge All"
                                style="-fx-background-color: white; -fx-border-color: #DDDDDD; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #444444; -fx-font-size: 12; -fx-cursor: hand; -fx-padding: 8 16 8 16;"/>
                    </children>
                </HBox>

                <!-- HQ ONLY: BRANCH SELECTOR -->
                <HBox fx:id="branchSelectorBox" spacing="12.0" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14 16 14 16; -fx-border-width: 1;">
                    <children>
                        <Label text="View alerts for:" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0D1B2A;"/>
                        <ComboBox fx:id="branchSelectorCombo" prefWidth="200.0"
                                  style="-fx-font-size: 12; -fx-background-color: white; -fx-border-color: #CCCCCC; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS"/>
                        <Label text="Select a branch to view its stock alerts" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                    </children>
                </HBox>

                <!-- Branch context info (shown for branch users) -->
                <Label fx:id="branchContextLabel"
                       text=""
                       visible="false" managed="false"
                       prefWidth="999.0"
                       style="-fx-text-fill: #2563EB; -fx-font-size: 12; -fx-padding: 8 14 8 14; -fx-background-color: #EFF6FF; -fx-border-color: #BFDBFE; -fx-border-radius: 6; -fx-background-radius: 6; -fx-border-width: 1;"/>

                <!-- ALERT BANNER -->
                <HBox style="-fx-background-color: #FEE2E2; -fx-border-color: #FCA5A5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14 18 14 18; -fx-border-width: 1;"
                      alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="!" style="-fx-font-size: 22; -fx-text-fill: #DC2626; -fx-font-weight: bold;"/>
                        <VBox spacing="2.0">
                            <children>
                                <Label fx:id="alertBannerTitle"
                                       text="Stock alerts detected"
                                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #991B1B;">
                                    <font><Font name="System Bold" size="14.0"/></font>
                                </Label>
                                <Label fx:id="alertBannerSub"
                                       text="Review stock levels and take action."
                                       style="-fx-font-size: 12; -fx-text-fill: #B91C1C;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- STAT CARDS -->
                <GridPane hgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                    </columnConstraints>
                    <rowConstraints><RowConstraints minHeight="80.0"/></rowConstraints>
                    <children>
                        <!-- Out of Stock -->
                        <VBox GridPane.columnIndex="0" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 16 14 0;">
                            <children><HBox><children>
                                <StackPane prefWidth="4.0" prefHeight="50.0" style="-fx-background-color: #DC2626; -fx-background-radius: 4 0 0 4;"/>
                                <VBox spacing="3.0" style="-fx-padding: 0 0 0 12;"><children>
                                    <Label text="Out of Stock" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                    <Label fx:id="outOfStockCount" text="0" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #DC2626;"><font><Font name="System Bold" size="20.0"/></font></Label>
                                    <Label text="Immediate action" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                </children></VBox>
                            </children></HBox></children>
                        </VBox>

                        <!-- Critical -->
                        <VBox GridPane.columnIndex="1" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 16 14 0;">
                            <children><HBox><children>
                                <StackPane prefWidth="4.0" prefHeight="50.0" style="-fx-background-color: #DC2626; -fx-background-radius: 4 0 0 4;"/>
                                <VBox spacing="3.0" style="-fx-padding: 0 0 0 12;"><children>
                                    <Label text="Critical" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                    <Label fx:id="criticalCount" text="0" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #DC2626;"><font><Font name="System Bold" size="20.0"/></font></Label>
                                    <Label text="&lt; 5 units left" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                </children></VBox>
                            </children></HBox></children>
                        </VBox>

                        <!-- Low Stock -->
                        <VBox GridPane.columnIndex="2" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 16 14 0;">
                            <children><HBox><children>
                                <StackPane prefWidth="4.0" prefHeight="50.0" style="-fx-background-color: #D97706; -fx-background-radius: 4 0 0 4;"/>
                                <VBox spacing="3.0" style="-fx-padding: 0 0 0 12;"><children>
                                    <Label text="Low Stock" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                    <Label fx:id="lowStockCount" text="0" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #D97706;"><font><Font name="System Bold" size="20.0"/></font></Label>
                                    <Label text="Monitor closely" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                </children></VBox>
                            </children></HBox></children>
                        </VBox>

                        <!-- Requests Sent -->
                        <VBox GridPane.columnIndex="3" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 16 14 0;">
                            <children><HBox><children>
                                <StackPane prefWidth="4.0" prefHeight="50.0" style="-fx-background-color: #2563EB; -fx-background-radius: 4 0 0 4;"/>
                                <VBox spacing="3.0" style="-fx-padding: 0 0 0 12;"><children>
                                    <Label text="Total Alerts" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>
                                    <Label fx:id="requestsSentCount" text="0" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2563EB;"><font><Font name="System Bold" size="20.0"/></font></Label>
                                    <Label text="Awaiting action" style="-fx-font-size: 10; -fx-text-fill: #888888;"/>
                                </children></VBox>
                            </children></HBox></children>
                        </VBox>
                    </children>
                </GridPane>

                <!-- ALERTS TABLE -->
                <VBox style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 0;">
                    <children>

                        <!-- TABLE HEADER -->
                        <HBox style="-fx-padding: 12 0 12 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1;" alignment="CENTER_LEFT">
                            <children>
                                <Label text="Product" prefWidth="160.0" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666; -fx-padding: 0 0 0 8;"/>
                                <Label fx:id="branchColHeader" text="Branch" prefWidth="120.0" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                <Label text="Current" prefWidth="110.0" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                <Label text="Min Level" prefWidth="110.0" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                <Label text="Level" prefWidth="130.0" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                <Label text="Status" prefWidth="100.0" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                <Label text="Request" prefWidth="100.0" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                                <Label text="Actions" prefWidth="200.0" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
                            </children>
                        </HBox>

                        <!-- ALERT ROWS -->
                        <VBox fx:id="alertsTableBody" spacing="0">
                            <children>

                                <!-- Alert Row 1: Out of Stock -->
                                <HBox fx:id="alertRowContainer1" style="-fx-padding: 10 0 10 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1; -fx-background-color: #FEE2E2;" alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="productLabel1" text="Sprite 500ml" prefWidth="160.0" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0D1B2A; -fx-padding: 0 0 0 8;"/>
                                        <Label fx:id="alertRow1Branch" text="Nairobi HQ" prefWidth="120.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                        <Label fx:id="currentStockLabel1" text="0 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #DC2626; -fx-font-weight: bold;"/>
                                        <Label fx:id="minStockLabel1" text="20 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <VBox prefWidth="130.0"><children><ProgressBar fx:id="progressBar1" progress="0.0" prefWidth="110.0" prefHeight="6.0" style="-fx-accent: #DC2626; -fx-background-color: #E5E7EB; -fx-background-radius: 4; -fx-border-radius: 4;"/></children></VBox>
                                        <Label fx:id="statusLabel1" text="Out of Stock" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #991B1B; -fx-background-color: #FEE2E2; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <Label text="Sent OK" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #059669;"/>
                                        <HBox spacing="6.0">
                                            <children>
                                                <Button fx:id="approveBtn1" onAction="#handleApproveRestock" prefHeight="28.0" prefWidth="68.0" text="Approve" style="-fx-background-color: #059669; -fx-background-radius: 4; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-border-color: transparent;"/>
                                                <Button fx:id="requestBtn1" onAction="#handleRequestRestock" prefHeight="28.0" prefWidth="110.0" text="Request Restock" visible="false" managed="false" style="-fx-background-color: #2563EB; -fx-background-radius: 4; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-border-color: transparent;"/>
                                                <Button onAction="#handleDismissAlert" prefHeight="28.0" prefWidth="56.0" text="Dismiss" style="-fx-background-color: transparent; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #666666; -fx-font-size: 11; -fx-cursor: hand;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <!-- Alert Row 2: Critical -->
                                <HBox fx:id="alertRowContainer2" style="-fx-padding: 10 0 10 0; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 1; -fx-background-color: #FFF5F5;" alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="productLabel2" text="Coca Cola 500ml" prefWidth="160.0" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0D1B2A; -fx-padding: 0 0 0 8;"/>
                                        <Label fx:id="alertRow2Branch" text="Nairobi HQ" prefWidth="120.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                        <Label fx:id="currentStockLabel2" text="3 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #DC2626; -fx-font-weight: bold;"/>
                                        <Label fx:id="minStockLabel2" text="20 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <VBox prefWidth="130.0"><children><ProgressBar fx:id="progressBar2" progress="0.08" prefWidth="110.0" prefHeight="6.0" style="-fx-accent: #DC2626; -fx-background-color: #E5E7EB; -fx-background-radius: 4; -fx-border-radius: 4;"/></children></VBox>
                                        <Label fx:id="statusLabel2" text="Critical" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #991B1B; -fx-background-color: #FFF5F5; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <Label text="Sent OK" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #059669;"/>
                                        <HBox spacing="6.0">
                                            <children>
                                                <Button fx:id="approveBtn2" onAction="#handleApproveRestock" prefHeight="28.0" prefWidth="68.0" text="Approve" style="-fx-background-color: #059669; -fx-background-radius: 4; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-border-color: transparent;"/>
                                                <Button fx:id="requestBtn2" onAction="#handleRequestRestock" prefHeight="28.0" prefWidth="110.0" text="Request Restock" visible="false" managed="false" style="-fx-background-color: #2563EB; -fx-background-radius: 4; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-border-color: transparent;"/>
                                                <Button onAction="#handleDismissAlert" prefHeight="28.0" prefWidth="56.0" text="Dismiss" style="-fx-background-color: transparent; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #666666; -fx-font-size: 11; -fx-cursor: hand;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <!-- Alert Row 3: Low -->
                                <HBox fx:id="alertRowContainer3" style="-fx-padding: 10 0 10 0; -fx-background-color: #FFFBEB;" alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="productLabel3" text="Fanta Orange 500ml" prefWidth="160.0" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0D1B2A; -fx-padding: 0 0 0 8;"/>
                                        <Label fx:id="alertRow3Branch" text="Nairobi HQ" prefWidth="120.0" style="-fx-font-size: 12; -fx-text-fill: #444444;"/>
                                        <Label fx:id="currentStockLabel3" text="8 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #D97706; -fx-font-weight: bold;"/>
                                        <Label fx:id="minStockLabel3" text="15 units" prefWidth="110.0" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
                                        <VBox prefWidth="130.0"><children><ProgressBar fx:id="progressBar3" progress="0.27" prefWidth="110.0" prefHeight="6.0" style="-fx-accent: #D97706; -fx-background-color: #E5E7EB; -fx-background-radius: 4; -fx-border-radius: 4;"/></children></VBox>
                                        <Label fx:id="statusLabel3" text="Low" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #92400E; -fx-background-color: #FEF3C7; -fx-background-radius: 10; -fx-padding: 2 8 2 8;"/>
                                        <Label text="Sent OK" prefWidth="100.0" style="-fx-font-size: 11; -fx-text-fill: #059669;"/>
                                        <HBox spacing="6.0">
                                            <children>
                                                <Button fx:id="approveBtn3" onAction="#handleApproveRestock" prefHeight="28.0" prefWidth="68.0" text="Approve" style="-fx-background-color: #059669; -fx-background-radius: 4; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-border-color: transparent;"/>
                                                <Button fx:id="requestBtn3" onAction="#handleRequestRestock" prefHeight="28.0" prefWidth="110.0" text="Request Restock" visible="false" managed="false" style="-fx-background-color: #2563EB; -fx-background-radius: 4; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-border-color: transparent;"/>
                                                <Button onAction="#handleDismissAlert" prefHeight="28.0" prefWidth="56.0" text="Dismiss" style="-fx-background-color: transparent; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #666666; -fx-font-size: 11; -fx-cursor: hand;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                    </children>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
