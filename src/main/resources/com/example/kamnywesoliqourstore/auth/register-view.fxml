<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="750.0" prefWidth="900.0" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kamnywesoliqourstore.auth.RegisterController">
<children>
    <VBox alignment="CENTER" maxWidth="420.0" maxHeight="-Infinity" spacing="20.0" styleClass="card">
        <children>
            <VBox alignment="CENTER" spacing="8.0">
                <Label styleClass="logo-box" text="KLS" />
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" styleClass="text-navy" text="Create Account" />
                <Label styleClass="text-muted" text="Join Kamnyweso Liquor Store Management System" />
            </VBox>

            <HBox alignment="CENTER" spacing="10.0">
                <Region fx:id="dot1" styleClass="dot, dot-active" />
                <Region fx:id="dot2" styleClass="dot" />
                <Region fx:id="dot3" styleClass="dot" />
            </HBox>

            <VBox fx:id="stepContainer" spacing="15.0" />

            <HBox alignment="CENTER" spacing="5.0" style="-fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-padding: 15 0 0 0;">
                <Label styleClass="text-muted" text="Already have an account?" />
                <Label onMouseClicked="#navigateToLogin" style="-fx-font-weight: bold; -fx-cursor: hand;" styleClass="text-primary" text="Sign In" />
            </HBox>
        </children>
    </VBox>
</children>
</StackPane>