<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane style="-fx-background-color: #0f172a;" stylesheets="@../style.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kamnywesoliqourstore.auth.PortalSelectorController">
    <children>
        <VBox alignment="CENTER" spacing="40.0" StackPane.alignment="CENTER">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40" />
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="10.0">
                    <Label style="-fx-background-color: #2563EB; -fx-background-radius: 16; -fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 15 25;" text="KLS" />
                    <Label style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;" text="Kamnyweso Liquor Store" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 16px;" text="Distributed Management System" />
                </VBox>

                <HBox alignment="CENTER" spacing="25.0">
                    <children>
                        <VBox onMouseClicked="#handleAdminSelect" spacing="15.0" styleClass="portal-card" alignment="TOP_LEFT" prefWidth="350.0" prefHeight="220.0" minWidth="320.0" minHeight="220.0" maxWidth="350.0" maxHeight="220.0">
                            <children>
                                <HBox styleClass="icon-box-admin" alignment="CENTER" maxWidth="-Infinity">
                                    <ImageView fitHeight="32.0" fitWidth="32.0" preserveRatio="true">
                                        <Image url="@../admin-icon.png" />
                                    </ImageView>
                                </HBox>
                                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Admin Portal" />
                                <Label wrapText="true" styleClass="text-muted" text="HQ Nairobi — Full system management, reports, stock control, and user management." />
                                <Label style="-fx-text-fill: #2563EB; -fx-font-weight: bold;" text="Enter Admin Portal →" />
                            </children>
                        </VBox>

                        <VBox onMouseClicked="#handleBranchSelect" spacing="15.0" styleClass="portal-card" alignment="TOP_LEFT" prefWidth="350.0" prefHeight="220.0" minWidth="320.0" minHeight="220.0" maxWidth="350.0" maxHeight="220.0">
                            <children>
                                <HBox styleClass="icon-box-branch" alignment="CENTER" maxWidth="-Infinity">
                                    <ImageView fitHeight="32.0" fitWidth="32.0" preserveRatio="true">
                                        <Image url="@../branch-icon.png" />
                                    </ImageView>
                                </HBox>
                                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Branch Portal" />
                                <Label wrapText="true" styleClass="text-muted" text="Place orders, track stock, manage loyalty, and handle returns at branch level." />
                                <Label style="-fx-text-fill: #22C55E; -fx-font-weight: bold;" text="Enter Branch Portal →" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Label style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 10px; -fx-letter-spacing: 2px;" text="4 BRANCHES: NAIROBI HQ • NAKURU • MOMBASA • KISUMU" />
            </children>
        </VBox>
    </children>
</StackPane>